{
  "version": 2,
  "env": {
    "LD_LIBRARY_PATH": "/var/task/backend/lib"
  },
  "builds": [
    {
      "src": "api/index.py",
      "use": "@vercel/python",
      "config": {
        "includeFiles": [
          "data/reference/gene_mapping.csv",
          "data/reference/kegg_cache/kegg_cgl_cgb.json",
          "data/reference/regulations.csv",
          "data/reference/rna_regulation.csv",
          "data/reference/AllOrganismsFiles/**",
          "data/reference/model/**",
          "data/reference/imodulon/**",
          "data/reference/rna_seq_analysis_results.json",
          "data/reference/metabolic_models/**",
          "data/reference/prodoric_pwms.json",
          "data/reference/essential_genes.json",
          "data/reference/abasy_roles.json",
          "data/reference/string_interactions.json",
          "data/reference/cog_annotations.json",
          "backend/models/**",
          "backend/lib/libexpat.so.1"
        ]
      }
    },
    {
      "src": "web/**",
      "use": "@vercel/static"
    },
    {
      "src": "data/reference/**",
      "use": "@vercel/static"
    }
  ],
  "routes": [
    {
      "src": "/api/(.*)",
      "dest": "api/index.py"
    },
    {
      "src": "/data/(.*)",
      "dest": "data/reference/$1"
    },
    {
      "src": "/(.*)",
      "dest": "web/$1"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "index, follow"
        }
      ]
    },
    {
      "source": "/lib/vendor/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/robots.txt",
      "headers": [
        {
          "key": "Content-Type",
          "value": "text/plain; charset=utf-8"
        }
      ]
    },
    {
      "source": "/sitemap.xml",
      "headers": [
        {
          "key": "Content-Type",
          "value": "application/xml; charset=utf-8"
        }
      ]
    }
  ]
}
